diff --git a/drivers/tee/qcomtee/shm.c b/drivers/tee/qcomtee/shm.c
--- a/drivers/tee/qcomtee/shm.c
+++ b/drivers/tee/qcomtee/shm.c
@@ -97,7 +97,38 @@ void qcomtee_msg_buffers_free(struct qcomtee_object_invoke_ctx *oic)
 	tee_shm_free(oic->out_shm);
 }
 
-/* Dynamic shared memory pool based on tee_dyn_shm_alloc_helper(). */
+/*
+ * A page-backed buffer is one alloc_pages_exact() block, so it needs a free
+ * buddy block of the next power of two, and above PAGE_ALLOC_COSTLY_ORDER the
+ * page allocator gives up rather than reclaim until one exists. After a day
+ * of uptime this tablet has hundreds of MiB free but no free 2 MiB block, and
+ * fprintd's 1.1 MiB HwVault image failed as an order-9 allocation. So every
+ * memory object larger than the page allocator serves cheaply comes from the
+ * TZMEM pool. Its areas are dma_alloc_coherent() memory -- CMA, which
+ * migrates movable pages out of the way instead of needing a free block --
+ * and an area stays in the pool once added, so the one the first fingerprint
+ * session grows for the 19 MiB dualfp image is reused by every later session.
+ *
+ * QTEE messages (TEE_SHM_PRIV) stay page-backed at any size. With HwVault's
+ * 160 KiB send-command message in TZMEM, the command returned success but
+ * its response area came back empty -- most likely because the pool's areas
+ * are a non-cacheable remap of memory that QTEE accesses as cacheable when it
+ * handles a message.
+ *
+ * Samsung's QSEECom compatibility layer gives dualfp two contiguous
+ * 0x2a4000-byte objects in addition to its large signed image, and those
+ * must be TZMEM: unlike a DMA address returned for the qcomtee platform
+ * device, qcom_tzmem_to_phys() is the physical address expected by the SHM
+ * bridge and by the secure-world memory-object callback.
+ *
+ * The EL721 ABI uses 32-bit physical addresses, matching stock's qseecom and
+ * qseecom-ta CMA pools, so every TZMEM allocation is requested from DMA32 and
+ * checked before it is exposed to TrustZone.
+ */
+#define QCOMTEE_SHM_POOL_MAX_SIZE	SZ_32M
+#define QCOMTEE_SHM_PAGES_MAX_SIZE	(PAGE_SIZE << PAGE_ALLOC_COSTLY_ORDER)
+/* Page-backed buffers below this size were in use before the TZMEM pool. */
+#define QCOMTEE_SHM_PAGES_FALLBACK_SIZE	SZ_2M
 
 static int qcomtee_shm_register(struct tee_context *ctx, struct tee_shm *shm,
 				struct page **pages, size_t num_pages,
@@ -114,20 +145,85 @@ static int qcomtee_shm_unregister(struct tee_context *ctx, struct tee_shm *shm)
 	return 0;
 }
 
+struct qcomtee_shm_pool {
+	struct tee_shm_pool base;
+	struct qcom_tzmem_pool *tzmem;
+};
+
+static struct qcomtee_shm_pool *to_qcomtee_shm_pool(struct tee_shm_pool *pool)
+{
+	return container_of(pool, struct qcomtee_shm_pool, base);
+}
+
+static int qcomtee_shm_alloc_tzmem(struct qcomtee_shm_pool *qpool,
+				   struct tee_shm *shm, size_t size)
+{
+	phys_addr_t paddr;
+	void *vaddr;
+
+	size = PAGE_ALIGN(size);
+	vaddr = qcom_tzmem_alloc(qpool->tzmem, size,
+				  GFP_KERNEL | GFP_DMA32);
+	if (!vaddr)
+		return -ENOMEM;
+
+	paddr = qcom_tzmem_to_phys(vaddr);
+	if (!paddr || paddr > U32_MAX || size - 1 > U32_MAX - paddr) {
+		qcom_tzmem_free(vaddr);
+		return -EOVERFLOW;
+	}
+
+	memzero_explicit(vaddr, size);
+	shm->kaddr = vaddr;
+	shm->paddr = paddr;
+	shm->size = size;
+	shm->pages = NULL;
+	shm->num_pages = 0;
+
+	return 0;
+}
+
 static int pool_op_alloc(struct tee_shm_pool *pool, struct tee_shm *shm,
 			 size_t size, size_t align)
 {
-	return tee_dyn_shm_alloc_helper(shm, size, align, qcomtee_shm_register);
+	int ret;
+
+	if (size <= QCOMTEE_SHM_PAGES_MAX_SIZE || (shm->flags & TEE_SHM_PRIV))
+		return tee_dyn_shm_alloc_helper(shm, size, align,
+						qcomtee_shm_register);
+
+	ret = qcomtee_shm_alloc_tzmem(to_qcomtee_shm_pool(pool), shm, size);
+	/*
+	 * The pool is capped and never shrinks. Should it be unable to serve a
+	 * buffer the page allocator used to back, try the page allocator.
+	 */
+	if (ret && size < QCOMTEE_SHM_PAGES_FALLBACK_SIZE)
+		ret = tee_dyn_shm_alloc_helper(shm, size, align,
+					       qcomtee_shm_register);
+
+	return ret;
 }
 
 static void pool_op_free(struct tee_shm_pool *pool, struct tee_shm *shm)
 {
-	tee_dyn_shm_free_helper(shm, qcomtee_shm_unregister);
+	if (shm->pages) {
+		tee_dyn_shm_free_helper(shm, qcomtee_shm_unregister);
+		return;
+	}
+
+	memzero_explicit(shm->kaddr, shm->size);
+	qcom_tzmem_free(shm->kaddr);
+	shm->kaddr = NULL;
+	shm->paddr = 0;
+	shm->size = 0;
 }
 
 static void pool_op_destroy_pool(struct tee_shm_pool *pool)
 {
-	kfree(pool);
+	struct qcomtee_shm_pool *qpool = to_qcomtee_shm_pool(pool);
+
+	qcom_tzmem_pool_free(qpool->tzmem);
+	kfree(qpool);
 }
 
 static const struct tee_shm_pool_ops pool_ops = {
@@ -138,13 +234,25 @@ static const struct tee_shm_pool_ops pool_ops = {
 
 struct tee_shm_pool *qcomtee_shm_pool_alloc(void)
 {
-	struct tee_shm_pool *pool;
+	const struct qcom_tzmem_pool_config config = {
+		.policy = QCOM_TZMEM_POLICY_ON_DEMAND,
+		.max_size = QCOMTEE_SHM_POOL_MAX_SIZE,
+	};
+	struct qcomtee_shm_pool *pool;
 
 	pool = kzalloc_obj(*pool);
 	if (!pool)
 		return ERR_PTR(-ENOMEM);
 
-	pool->ops = &pool_ops;
+	pool->tzmem = qcom_tzmem_pool_new(&config);
+	if (IS_ERR(pool->tzmem)) {
+		struct qcom_tzmem_pool *tzmem = pool->tzmem;
+
+		kfree(pool);
+		return ERR_CAST(tzmem);
+	}
+
+	pool->base.ops = &pool_ops;
 
-	return pool;
+	return &pool->base;
 }
