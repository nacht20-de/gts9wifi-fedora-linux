@@ -15,6 +15,51 @@
 #define EL721_LIGHT_SETTLE_US (1200 * 1000)
 #endif
 
+/* Verification only needs the fingertip flat enough for the matcher, and every
+ * millisecond spent here is a millisecond the user waits at the lock screen.
+ * Enrolment keeps the longer reference settle above, because one marginal
+ * sample there costs a whole stage instead of a single re-press. The reference
+ * value's own measurement note says 700 ms already reached 88-100 coverage, so
+ * the reference carries margin that verification does not need. */
+#ifndef EL721_LIGHT_SETTLE_VERIFY_US
+#define EL721_LIGHT_SETTLE_VERIFY_US (700 * 1000)
+#endif
+
+/* Both settles are overridable at run time so they can be measured without a
+ * rebuild. fprintd is D-Bus activated and starts per operation, so a drop-in
+ * unit file plus a restart is enough:
+ *
+ *   EL721_LIGHT_SETTLE_MS=<ms>         applies to every action
+ *   EL721_LIGHT_SETTLE_VERIFY_MS=<ms>  verification and identification only
+ *
+ * Anything that is not a positive value of at most 5 s is ignored. The result
+ * is cached because this is consulted from the poll loop. */
+static inline gint64
+el721_light_settle_us (gboolean verify)
+{
+  static gint64 verify_us = -1;
+  static gint64 other_us = -1;
+  const char *env;
+  gint64 ms;
+
+  if (verify && verify_us >= 0)
+    return verify_us;
+  if (!verify && other_us >= 0)
+    return other_us;
+
+  env = verify ? g_getenv ("EL721_LIGHT_SETTLE_VERIFY_MS") : NULL;
+  if (!env)
+    env = g_getenv ("EL721_LIGHT_SETTLE_MS");
+  ms = env ? g_ascii_strtoll (env, NULL, 10) : 0;
+
+  if (verify)
+    verify_us = (ms > 0 && ms <= 5000) ? ms * 1000 : EL721_LIGHT_SETTLE_VERIFY_US;
+  else
+    other_us = (ms > 0 && ms <= 5000) ? ms * 1000 : EL721_LIGHT_SETTLE_US;
+
+  return verify ? verify_us : other_us;
+}
